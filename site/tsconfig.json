{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noImplicitAny": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noUnusedLocals": true, "noFallthroughCasesInSwitch": true,
    "isolatedModules": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["vite/client", "node"], "noEmit": true
  },
  "include": ["src"]
}
